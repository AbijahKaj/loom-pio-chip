; 8N1 UART transmitter, LSB first.
; Pins: side-set base and out base = TX pin. 4 ticks per bit:
;   clkdiv = f_clk / (4 * baud)
; Host pushes one byte per FIFO word (low 8 bits). out_shift_right = 1.
.program uart_tx
.side_set 1 opt
.wrap_target
    pull block      side 1 [3]   ; stop bit / idle (line held high while stalled)
    set x, 7        side 0 [3]   ; start bit
bitloop:
    out pins, 1
    jmp x--, bitloop       [2]
.wrap
