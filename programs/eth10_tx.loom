; 10BASE-T transmitter: Manchester encoding at 10 Mb/s (20 M symbols/s).
; clkdiv = f_clk / 20 MHz (3 at 60 MHz, 2 at 40 MHz): one tick per half bit. Needs an integer divider.
; out_base = set_base = TD+ (GPIO n), TD- = GPIO n+1 (diff), set_count = 2.
; Coder: Manchester, IEEE polarity ('1' = low->high), no stuffing.
; out_shift_right = 1 (Ethernet is LSB first), autopull threshold 32.
; Host pushes: bit count (preamble + SFD + frame + FCS), then the bits.
.program eth10_tx
.wrap_target
    pull block
    mov x, osr
    out null, 32
    helper coder
    out.c pins, 0            ; X-counted Manchester stream
    set pins, 1      [5]     ; TP_IDL: hold high for 300 ns
    set pins, 0              ; idle (no differential voltage)
.wrap
