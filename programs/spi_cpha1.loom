; SPI controller, CPHA = 1 (modes 1 and 3). Full duplex, 4 ticks per bit.
; Same pin/shift setup as spi_cpha0. Assemble with CPOL=1 for mode 3.
.program spi_cpha1
.side_set 1
.define CPOL 0
.wrap_target
    out x, 1        side CPOL           ; stalls here with SCK idle when TX FIFO empty
    mov pins, x     side 1-CPOL   [1]   ; leading edge: drive data
    in pins, 1      side CPOL           ; trailing edge: sample
.wrap
